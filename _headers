# Cloudflare Pages / Netlify — кеширане на файловете
# HTML и service worker — винаги свежи (новата версия се вижда веднага)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# CSS/JS са с ?v=… в адреса → кешират се за година
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
